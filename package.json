{
  "name": "mritoolbox",
  "version": "3.0.0",
  "private": true,
  "description": "MRI calculations from mritoolbox.com: Ernst angle, contrast optimisation, relaxation curve fitting, MP-RAGE simulation and a database of published T1 and T2 values.",
  "keywords": [
    "mri",
    "relaxometry",
    "t1",
    "t2",
    "ernst angle",
    "curve fitting",
    "mp-rage",
    "epg"
  ],
  "homepage": "https://github.com/abmcmillan/mritoolbox-lib#readme",
  "bugs": {
    "url": "https://github.com/abmcmillan/mritoolbox-lib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abmcmillan/mritoolbox-lib.git"
  },
  "author": "Alan McMillan",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data/parameter-database.json": "./data/parameter-database.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "mritoolbox": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/embed-data.mjs && tsc -p tsconfig.json && tsc -p tsconfig.cli.json && node scripts/build-info.mjs",
    "test": "npm run build && vitest run && npm run test:node",
    "test:node": "node --test tests/node/library.test.mjs tests/node/cli.test.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
